{
  "entities": {
    "users": {
      "title": "users",
      "description": "Core user identities and access status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "accountType": {
          "type": "string",
          "enum": ["APPLICANT", "LEARNER", "STAFF"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "INACTIVE"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "accountType", "accountStatus"]
    },
    "staffProfiles": {
      "title": "staffProfiles",
      "description": "Internal staff role assignments and permissions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "staffRole": {
          "type": "string",
          "enum": ["PROGRAMME_MANAGER", "FACILITATOR", "ME", "ADMIN"]
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "staffRole", "active"]
    },
    "enrolments": {
      "title": "enrolments",
      "description": "Learner programme and cohort enrolment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "programmeId": { "type": "string" },
        "cohortId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "COMPLETED", "WITHDRAWN", "SUSPENDED"]
        },
        "enrolledAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "programmeId", "cohortId", "status"]
    },
    "programmes": {
      "title": "programmes",
      "description": "Educational and empowerment programmes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "duration": { "type": "string" },
        "deliveryFormat": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "auditLogs": {
      "title": "auditLogs",
      "description": "Immutable platform audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["actorId", "action", "timestamp"]
    }
  }
}
